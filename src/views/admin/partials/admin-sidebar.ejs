<aside class="admin-sidebar" id="adminSidebar">
  <div class="sidebar-header">
    <a href="/" class="sidebar-logo" target="_blank">
      <svg width="28" height="28" viewBox="0 0 40 40" fill="none">
        <path d="M20 3C20 3 11 8 9 17C7 26 14 30 20 38C26 30 33 26 31 17C29 8 20 3 20 3Z" fill="url(#sideGrad2)"/>
        <defs><linearGradient id="sideGrad2" x1="9" y1="3" x2="31" y2="38"><stop stop-color="#E8B84B"/><stop offset="1" stop-color="#C9962A"/></linearGradient></defs>
      </svg>
      <span>D'Abbah Admin</span>
    </a>
    <button class="sidebar-close" id="sidebarClose">×</button>
  </div>

  <nav class="sidebar-nav">
    <div class="nav-group">
      <span class="nav-group-label">Overview</span>
      <a href="/admin" class="nav-item <%= typeof activePage !== 'undefined' && activePage === 'dashboard' ? 'active' : '' %>">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
        Dashboard
      </a>
    </div>
    <div class="nav-group">
      <span class="nav-group-label">Content</span>
      <a href="/admin/blog" class="nav-item <%= typeof activePage !== 'undefined' && activePage === 'blog' ? 'active' : '' %>">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        Blog & News
      </a>
      <a href="/admin/programs" class="nav-item <%= typeof activePage !== 'undefined' && activePage === 'programs' ? 'active' : '' %>">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/></svg>
        Programs
      </a>
      <a href="/admin/gallery" class="nav-item <%= typeof activePage !== 'undefined' && activePage === 'gallery' ? 'active' : '' %>">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
        Gallery
      </a>
      <a href="/admin/testimonials" class="nav-item <%= typeof activePage !== 'undefined' && activePage === 'testimonials' ? 'active' : '' %>">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        Testimonials
      </a>
    </div>
    <div class="nav-group">
      <span class="nav-group-label">Community</span>
      <a href="/admin/contacts" class="nav-item <%= typeof activePage !== 'undefined' && activePage === 'contacts' ? 'active' : '' %>">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        Messages
      </a>
      <a href="/admin/volunteers" class="nav-item <%= typeof activePage !== 'undefined' && activePage === 'volunteers' ? 'active' : '' %>">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
        Volunteers
      </a>
      <a href="/admin/subscribers" class="nav-item <%= typeof activePage !== 'undefined' && activePage === 'subscribers' ? 'active' : '' %>">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
        Subscribers
      </a>
    </div>
    <div class="nav-group">
      <span class="nav-group-label">Finance</span>
      <a href="/admin/donations" class="nav-item <%= typeof activePage !== 'undefined' && activePage === 'donations' ? 'active' : '' %>">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        Donations
      </a>
    </div>
  </nav>

  <div class="sidebar-footer">
    <div class="sidebar-user">
      <div class="sidebar-avatar"><%= (user?.name || 'A')[0] %></div>
      <div>
        <span class="sidebar-user-name"><%= user?.name || 'Admin' %></span>
        <span class="sidebar-user-role"><%= user?.role || 'admin' %></span>
      </div>
    </div>
    <a href="/auth/logout" class="btn-sidebar-logout" title="Sign out">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
    </a>
  </div>
</aside>
