<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= title %></title>
  <meta name="robots" content="noindex"/>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/main.css"/>
  <link rel="stylesheet" href="/css/admin.css"/>
</head>
<body class="admin-body">
  <%- include('../partials/admin-sidebar', { activePage: 'blog' }) %>

  <div class="admin-main">
    <%- include('../partials/admin-topbar', { pageTitle: 'Blog & News' }) %>

    <div class="admin-content">
      <div class="admin-page-header">
        <div>
          <h2>Blog & News</h2>
          <p><%= total %> total posts</p>
        </div>
        <a href="/admin/blog/new" class="btn-admin-primary">+ New Post</a>
      </div>

      <!-- Filters -->
      <div class="admin-filters">
        <form method="GET" action="/admin/blog" class="filter-form">
          <select name="status" onchange="this.form.submit()">
            <option value="" <%= !filter.status ? 'selected' : '' %>>All Statuses</option>
            <option value="published" <%= filter.status === 'published' ? 'selected' : '' %>>Published</option>
            <option value="draft" <%= filter.status === 'draft' ? 'selected' : '' %>>Draft</option>
            <option value="archived" <%= filter.status === 'archived' ? 'selected' : '' %>>Archived</option>
          </select>
          <select name="category" onchange="this.form.submit()">
            <option value="">All Categories</option>
            <% ['News','Programs','Stories','Awareness','Events','Reports'].forEach(cat => { %>
            <option value="<%= cat %>" <%= filter.category === cat ? 'selected' : '' %>><%= cat %></option>
            <% }) %>
          </select>
        </form>
      </div>

      <!-- Posts Table -->
      <div class="admin-panel">
        <div class="panel-body">
          <% if (posts && posts.length > 0) { %>
          <table class="admin-table admin-table-full">
            <thead>
              <tr>
                <th>Title</th><th>Category</th><th>Author</th><th>Status</th><th>Views</th><th>Date</th><th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% posts.forEach(post => { %>
              <tr>
                <td>
                  <div class="blog-title-cell">
                    <% if (post.coverImage?.url) { %>
                    <img src="<%= post.coverImage.url %>" alt="" width="48" height="36" class="blog-thumb"/>
                    <% } %>
                    <div>
                      <span class="blog-title-text"><%= post.title %></span>
                      <span class="blog-slug">/<%= post.slug %></span>
                    </div>
                  </div>
                </td>
                <td><span class="cat-tag"><%= post.category %></span></td>
                <td><%= post.author?.name || 'Unknown' %></td>
                <td><span class="status-badge status-<%= post.status %>"><%= post.status %></span></td>
                <td><%= (post.views || 0).toLocaleString() %></td>
                <td><%= new Date(post.createdAt).toLocaleDateString('en-NG') %></td>
                <td class="actions-cell">
                  <a href="/admin/blog/<%= post._id %>/edit" class="action-btn action-edit" title="Edit">✏️</a>
                  <% if (post.status === 'published') { %>
                  <a href="/blog/<%= post.slug %>" target="_blank" class="action-btn action-view" title="View">👁</a>
                  <% } %>
                  <button onclick="deletePost('<%= post._id %>')" class="action-btn action-delete" title="Delete">🗑</button>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>

          <!-- Pagination -->
          <% if (pages > 1) { %>
          <div class="admin-pagination">
            <% for (let i = 1; i <= pages; i++) { %>
            <a href="?page=<%= i %><%= filter.status ? '&status=' + filter.status : '' %><%= filter.category ? '&category=' + filter.category : '' %>" class="page-btn <%= page === i ? 'active' : '' %>"><%= i %></a>
            <% } %>
          </div>
          <% } %>

          <% } else { %>
          <div class="panel-empty">
            <p>No posts found. <a href="/admin/blog/new">Create your first post →</a></p>
          </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <script>
    async function deletePost(id) {
      if (!confirm('Are you sure you want to delete this post? This cannot be undone.')) return;
      try {
        const res = await fetch(`/api/blogs/${id}`, { method: 'DELETE' });
        const data = await res.json();
        if (data.success) location.reload();
        else alert('Delete failed: ' + data.error);
      } catch (e) { alert('An error occurred.'); }
    }
  </script>
</body>
</html>
