<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= title %></title>
  <meta name="robots" content="noindex"/>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/main.css"/>
  <link rel="stylesheet" href="/css/admin.css"/>
  <style>
    .editor-wrap { background: var(--card-bg); border: 1px solid var(--border-admin); border-radius: 16px; padding: 2rem; }
    .editor-grid { display: grid; grid-template-columns: 1fr 320px; gap: 2rem; }
    .editor-label { display: block; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-admin-muted); margin-bottom: 0.5rem; }
    .editor-input { width: 100%; background: rgba(255,255,255,0.04); border: 1px solid var(--border-admin); border-radius: 10px; padding: 0.875rem 1rem; color: var(--text-admin); font-family: 'Plus Jakarta Sans', sans-serif; font-size: 0.95rem; outline: none; transition: border-color 0.2s; }
    .editor-input:focus { border-color: rgba(201,150,42,0.5); }
    .editor-input.large { min-height: 400px; font-family: 'Fira Code', monospace; font-size: 0.875rem; resize: vertical; }
    select.editor-input { cursor: pointer; }
    .editor-field { margin-bottom: 1.5rem; }
    .editor-sidebar-card { background: rgba(255,255,255,0.03); border: 1px solid var(--border-admin); border-radius: 12px; padding: 1.25rem; margin-bottom: 1.25rem; }
    .editor-sidebar-card h4 { font-size: 0.8rem; font-weight: 600; color: white; margin-bottom: 1rem; text-transform: uppercase; letter-spacing: 0.08em; }
    .btn-publish { width: 100%; padding: 0.875rem; background: var(--gold); color: var(--navy-deep); border: none; border-radius: 10px; font-weight: 700; cursor: pointer; transition: all 0.2s; margin-bottom: 0.75rem; }
    .btn-publish:hover { background: var(--gold-light); }
    .btn-save-draft { width: 100%; padding: 0.75rem; background: transparent; color: var(--text-admin-muted); border: 1px solid var(--border-admin); border-radius: 10px; font-weight: 600; cursor: pointer; transition: all 0.2s; font-size: 0.875rem; font-family: inherit; }
    .btn-save-draft:hover { border-color: rgba(255,255,255,0.25); color: white; }
    .editor-title-field input { font-family: 'Cormorant Garamond', serif; font-size: 1.5rem; font-weight: 700; }
    .cover-upload { border: 2px dashed var(--border-admin); border-radius: 12px; padding: 2rem; text-align: center; cursor: pointer; transition: all 0.2s; }
    .cover-upload:hover { border-color: rgba(201,150,42,0.4); }
    .cover-upload p { font-size: 0.8rem; color: var(--text-admin-muted); margin-top: 0.5rem; }
    .tag-input-wrap { display: flex; flex-wrap: wrap; gap: 0.4rem; padding: 0.5rem; background: rgba(255,255,255,0.04); border: 1px solid var(--border-admin); border-radius: 10px; }
    .tag-chip { background: rgba(201,150,42,0.12); color: var(--gold-light); border: 1px solid rgba(201,150,42,0.2); border-radius: 100px; padding: 0.2rem 0.6rem; font-size: 0.75rem; display: flex; align-items: center; gap: 0.3rem; }
    .tag-chip button { background: none; border: none; color: inherit; cursor: pointer; padding: 0; font-size: 1rem; line-height: 1; }
  </style>
</head>
<body class="admin-body">
  <%- include('../partials/admin-sidebar', { activePage: 'blog' }) %>
  <div class="admin-main">
    <%- include('../partials/admin-topbar', { pageTitle: post ? 'Edit Post' : 'New Post' }) %>
    <div class="admin-content">
      <div class="admin-page-header">
        <div>
          <h2><%= post ? 'Edit Post' : 'Create New Post' %></h2>
          <a href="/admin/blog" style="color:var(--text-admin-muted); font-size:.8rem;">← Back to Posts</a>
        </div>
      </div>

      <form id="blogEditorForm">
        <input type="hidden" id="postId" value="<%= post?._id || '' %>"/>
        <div class="editor-grid">
          <!-- Main Editor -->
          <div class="editor-main">
            <div class="editor-wrap">
              <div class="editor-field editor-title-field">
                <label class="editor-label" for="postTitle">Post Title</label>
                <input type="text" id="postTitle" class="editor-input" placeholder="Enter a compelling title..." value="<%= post?.title || '' %>"/>
              </div>
              <div class="editor-field">
                <label class="editor-label" for="postExcerpt">Excerpt / Summary</label>
                <textarea id="postExcerpt" class="editor-input" rows="3" placeholder="Brief summary shown in listings and social shares..."><%= post?.excerpt || '' %></textarea>
              </div>
              <div class="editor-field">
                <label class="editor-label" for="postContent">Content <small style="text-transform:none; font-weight:400">(HTML or Markdown)</small></label>
                <textarea id="postContent" class="editor-input large" placeholder="Write your full post content here..."><%= post?.content || '' %></textarea>
              </div>
            </div>
          </div>

          <!-- Sidebar -->
          <div class="editor-sidebar">
            <div class="editor-sidebar-card">
              <h4>Publish</h4>
              <button type="button" class="btn-publish" onclick="savePost('published')">
                <% if (post?.status === 'published') { %>Update Published Post<% } else { %>Publish Now<% } %>
              </button>
              <button type="button" class="btn-save-draft" onclick="savePost('draft')">Save as Draft</button>
              <% if (post?.status === 'published') { %>
              <a href="/blog/<%= post.slug %>" target="_blank" style="display:block; text-align:center; font-size:.8rem; color:var(--gold); margin-top:.75rem; text-decoration:none;">View Live Post →</a>
              <% } %>
            </div>

            <div class="editor-sidebar-card">
              <h4>Settings</h4>
              <div class="editor-field">
                <label class="editor-label" for="postCategory">Category</label>
                <select id="postCategory" class="editor-input">
                  <% ['News','Programs','Stories','Awareness','Events','Reports'].forEach(cat => { %>
                  <option value="<%= cat %>" <%= post?.category === cat ? 'selected' : '' %>><%= cat %></option>
                  <% }) %>
                </select>
              </div>
              <div class="editor-field">
                <label class="editor-label">
                  <input type="checkbox" id="postFeatured" <%= post?.featured ? 'checked' : '' %>/> Featured Post
                </label>
              </div>
            </div>

            <div class="editor-sidebar-card">
              <h4>Cover Image URL</h4>
              <div class="editor-field">
                <input type="url" id="coverImageUrl" class="editor-input" placeholder="https://..." value="<%= post?.coverImage?.url || '' %>"/>
              </div>
              <div class="editor-field">
                <input type="text" id="coverImageAlt" class="editor-input" placeholder="Image alt text..." value="<%= post?.coverImage?.alt || '' %>"/>
              </div>
            </div>

            <div class="editor-sidebar-card">
              <h4>SEO</h4>
              <div class="editor-field">
                <label class="editor-label" for="metaTitle">Meta Title</label>
                <input type="text" id="metaTitle" class="editor-input" placeholder="SEO title (60 chars max)" value="<%= post?.seo?.metaTitle || '' %>"/>
              </div>
              <div class="editor-field">
                <label class="editor-label" for="metaDesc">Meta Description</label>
                <textarea id="metaDesc" class="editor-input" rows="3" placeholder="SEO description (160 chars max)"><%= post?.seo?.metaDescription || '' %></textarea>
              </div>
            </div>

            <div id="saveStatus" style="text-align:center; font-size:.8rem; color:var(--text-admin-muted); margin-top:.5rem;"></div>
          </div>
        </div>
      </form>
    </div>
  </div>

  <script>
    async function savePost(status) {
      const id = document.getElementById('postId').value;
      const statusEl = document.getElementById('saveStatus');
      const payload = {
        title: document.getElementById('postTitle').value,
        excerpt: document.getElementById('postExcerpt').value,
        content: document.getElementById('postContent').value,
        category: document.getElementById('postCategory').value,
        status,
        featured: document.getElementById('postFeatured').checked,
        coverImage: {
          url: document.getElementById('coverImageUrl').value,
          alt: document.getElementById('coverImageAlt').value,
        },
        seo: {
          metaTitle: document.getElementById('metaTitle').value,
          metaDescription: document.getElementById('metaDesc').value,
        },
      };

      statusEl.textContent = 'Saving...';
      try {
        const url = id ? `/api/blogs/${id}` : '/api/blogs';
        const method = id ? 'PUT' : 'POST';
        const res = await fetch(url, { method, headers: {'Content-Type':'application/json'}, body: JSON.stringify(payload) });
        const data = await res.json();
        if (data.success) {
          statusEl.style.color = '#4ade80';
          statusEl.textContent = '✓ Saved successfully';
          if (!id && data.data?._id) {
            document.getElementById('postId').value = data.data._id;
            history.replaceState(null, '', `/admin/blog/${data.data._id}/edit`);
          }
        } else {
          statusEl.style.color = '#f87171';
          statusEl.textContent = '✗ ' + (data.error || 'Save failed');
        }
      } catch(e) {
        statusEl.style.color = '#f87171';
        statusEl.textContent = '✗ Network error';
      }
    }

    // Auto-save draft every 60 seconds
    setInterval(() => {
      const id = document.getElementById('postId').value;
      if (document.getElementById('postTitle').value.trim()) savePost('draft');
    }, 60000);
  </script>
</body>
</html>
