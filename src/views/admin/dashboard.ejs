<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= title %></title>
  <meta name="robots" content="noindex, nofollow"/>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/main.css"/>
  <link rel="stylesheet" href="/css/admin.css"/>
</head>
<body class="admin-body">

  <!-- Sidebar -->
  <aside class="admin-sidebar" id="adminSidebar">
    <div class="sidebar-header">
      <a href="/" class="sidebar-logo" target="_blank">
        <svg width="32" height="32" viewBox="0 0 40 40" fill="none">
          <path d="M20 3C20 3 11 8 9 17C7 26 14 30 20 38C26 30 33 26 31 17C29 8 20 3 20 3Z" fill="url(#sideGrad)"/>
          <defs><linearGradient id="sideGrad" x1="9" y1="3" x2="31" y2="38"><stop stop-color="#E8B84B"/><stop offset="1" stop-color="#C9962A"/></linearGradient></defs>
        </svg>
        <span>D'Abbah Admin</span>
      </a>
      <button class="sidebar-close" id="sidebarClose" aria-label="Close sidebar">×</button>
    </div>

    <nav class="sidebar-nav">
      <div class="nav-group">
        <span class="nav-group-label">Overview</span>
        <a href="/admin" class="nav-item active">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
          Dashboard
        </a>
      </div>
      <div class="nav-group">
        <span class="nav-group-label">Content</span>
        <a href="/admin/blog" class="nav-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
          Blog & News
        </a>
        <a href="/admin/programs" class="nav-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
          Programs
        </a>
        <a href="/admin/gallery" class="nav-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
          Gallery
        </a>
        <a href="/admin/testimonials" class="nav-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          Testimonials
        </a>
      </div>
      <div class="nav-group">
        <span class="nav-group-label">Community</span>
        <a href="/admin/contacts" class="nav-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          Contact Submissions
        </a>
        <a href="/admin/volunteers" class="nav-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          Volunteers
        </a>
        <a href="/admin/subscribers" class="nav-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.5 2 2 0 0 1 3.59 1.32h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6 6l1.76-1.76a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7a2 2 0 0 1 1.72 2.02z"/></svg>
          Subscribers
        </a>
      </div>
      <div class="nav-group">
        <span class="nav-group-label">Finance</span>
        <a href="/admin/donations" class="nav-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          Donations
        </a>
      </div>
    </nav>

    <div class="sidebar-footer">
      <div class="sidebar-user">
        <div class="sidebar-avatar"><%= (user?.name || 'A')[0] %></div>
        <div>
          <span class="sidebar-user-name"><%= user?.name || 'Admin' %></span>
          <span class="sidebar-user-role"><%= user?.role || 'admin' %></span>
        </div>
      </div>
      <a href="/auth/logout" class="btn-logout" title="Logout">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
      </a>
    </div>
  </aside>

  <!-- Main Content -->
  <div class="admin-main">
    <!-- Topbar -->
    <header class="admin-topbar">
      <button class="sidebar-toggle" id="sidebarToggle" aria-label="Toggle sidebar">
        <span></span><span></span><span></span>
      </button>
      <h1 class="admin-page-title">Dashboard</h1>
      <div class="admin-topbar-right">
        <a href="/" target="_blank" class="btn-view-site">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          View Site
        </a>
        <a href="/auth/logout" class="btn-admin-logout">Sign Out</a>
      </div>
    </header>

    <div class="admin-content">
      <!-- Welcome Banner -->
      <div class="admin-welcome">
        <div>
          <h2>Welcome back, <%= user?.name?.split(' ')[0] || 'Admin' %> 👋</h2>
          <p>Here's what's happening at D'Abbah Foundation today.</p>
        </div>
        <a href="/admin/blog/new" class="btn-admin-primary">+ New Post</a>
      </div>

      <!-- Stats Grid -->
      <div class="admin-stats-grid">
        <div class="admin-stat-card stat-blue">
          <div class="stat-icon">💰</div>
          <div class="stat-info">
            <span class="stat-value">₦<%= stats.donationAmount.toLocaleString() %></span>
            <span class="stat-label">Total Donations</span>
          </div>
          <span class="stat-badge"><%= stats.totalDonations %> verified</span>
        </div>
        <div class="admin-stat-card stat-amber">
          <div class="stat-icon">📬</div>
          <div class="stat-info">
            <span class="stat-value"><%= stats.unreadContacts %></span>
            <span class="stat-label">Unread Messages</span>
          </div>
          <a href="/admin/contacts" class="stat-badge stat-badge-link">View all →</a>
        </div>
        <div class="admin-stat-card stat-green">
          <div class="stat-icon">🙋</div>
          <div class="stat-info">
            <span class="stat-value"><%= stats.pendingVolunteers %></span>
            <span class="stat-label">Pending Volunteers</span>
          </div>
          <a href="/admin/volunteers" class="stat-badge stat-badge-link">Review →</a>
        </div>
        <div class="admin-stat-card stat-purple">
          <div class="stat-icon">📝</div>
          <div class="stat-info">
            <span class="stat-value"><%= stats.publishedPosts %></span>
            <span class="stat-label">Published Posts</span>
          </div>
          <a href="/admin/blog" class="stat-badge stat-badge-link">Manage →</a>
        </div>
      </div>

      <!-- Recent Activity -->
      <div class="admin-panels">
        <!-- Recent Donations -->
        <div class="admin-panel">
          <div class="panel-header">
            <h3>Recent Donations</h3>
            <a href="/admin/donations" class="panel-link">View all</a>
          </div>
          <div class="panel-body">
            <% if (recentDonations && recentDonations.length > 0) { %>
            <table class="admin-table">
              <thead>
                <tr><th>Donor</th><th>Amount</th><th>Gateway</th><th>Date</th><th>Status</th></tr>
              </thead>
              <tbody>
                <% recentDonations.forEach(d => { %>
                <tr>
                  <td><%= d.donor.anonymous ? 'Anonymous' : d.donor.name %></td>
                  <td class="amount-cell">₦<%= d.amount.toLocaleString() %></td>
                  <td><span class="gateway-tag"><%= d.gateway %></span></td>
                  <td><%= new Date(d.createdAt).toLocaleDateString('en-NG') %></td>
                  <td><span class="status-badge status-<%= d.status %>"><%= d.status %></span></td>
                </tr>
                <% }) %>
              </tbody>
            </table>
            <% } else { %>
            <div class="panel-empty">No donations yet.</div>
            <% } %>
          </div>
        </div>

        <!-- Recent Contact Submissions -->
        <div class="admin-panel">
          <div class="panel-header">
            <h3>Recent Messages</h3>
            <a href="/admin/contacts" class="panel-link">View all</a>
          </div>
          <div class="panel-body">
            <% if (recentContacts && recentContacts.length > 0) { %>
            <div class="contact-list">
              <% recentContacts.forEach(c => { %>
              <div class="contact-item">
                <div class="contact-item-avatar"><%= c.name[0] %></div>
                <div class="contact-item-body">
                  <div class="contact-item-header">
                    <span class="contact-item-name"><%= c.name %></span>
                    <span class="status-dot status-dot-<%= c.status %>"></span>
                  </div>
                  <span class="contact-item-subject"><%= c.subject %></span>
                  <p class="contact-item-preview"><%= c.message.substring(0, 80) %>...</p>
                  <span class="contact-item-time"><%= new Date(c.createdAt).toLocaleDateString('en-NG') %></span>
                </div>
              </div>
              <% }) %>
            </div>
            <% } else { %>
            <div class="panel-empty">No messages yet.</div>
            <% } %>
          </div>
        </div>
      </div>

      <!-- Quick Actions -->
      <div class="admin-quick-actions">
        <h3>Quick Actions</h3>
        <div class="quick-actions-grid">
          <a href="/admin/blog/new" class="quick-action">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
            Write New Post
          </a>
          <a href="/admin/gallery" class="quick-action">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
            Upload Photos
          </a>
          <a href="/admin/volunteers" class="quick-action">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
            Review Volunteers
          </a>
          <a href="/admin/testimonials" class="quick-action">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            Manage Testimonials
          </a>
          <a href="/admin/programs" class="quick-action">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/></svg>
            Edit Programs
          </a>
          <a href="/admin/donations" class="quick-action">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            View Donations
          </a>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Sidebar toggle
    const sidebar = document.getElementById('adminSidebar');
    document.getElementById('sidebarToggle')?.addEventListener('click', () => sidebar.classList.toggle('open'));
    document.getElementById('sidebarClose')?.addEventListener('click', () => sidebar.classList.remove('open'));
  </script>
</body>
</html>
