<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= title %></title>
  <meta name="robots" content="noindex, nofollow"/>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600&family=Plus+Jakarta+Sans:wght@400;500;600&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/main.css"/>
  <style>
    body { background: var(--navy-deep); min-height: 100vh; display: flex; align-items: center; justify-content: center; }
    .login-wrap { width: 100%; max-width: 420px; padding: 2rem; }
    .login-logo { text-align: center; margin-bottom: 2.5rem; }
    .login-logo svg { margin-bottom: .75rem; }
    .login-logo span { display: block; font-family: 'Cormorant Garamond', serif; font-size: 1.5rem; color: var(--white); }
    .login-card { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.1); border-radius: 20px; padding: 2.5rem; backdrop-filter: blur(12px); }
    .login-card h2 { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 1.25rem; color: var(--white); margin-bottom: 0.5rem; font-weight: 600; }
    .login-card p { color: rgba(255,255,255,0.5); font-size: .875rem; margin-bottom: 2rem; }
    .login-error { background: rgba(239,68,68,.1); border: 1px solid rgba(239,68,68,.3); border-radius: 10px; padding: .75rem 1rem; color: #fca5a5; font-size: .875rem; margin-bottom: 1.5rem; }
    .login-form .form-group { margin-bottom: 1.25rem; }
    .login-form label { display: block; color: rgba(255,255,255,.7); font-size: .8rem; font-weight: 500; margin-bottom: .5rem; letter-spacing: .04em; text-transform: uppercase; }
    .login-form input { width: 100%; background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.12); border-radius: 10px; padding: .875rem 1rem; color: white; font-size: .95rem; transition: border-color .2s; }
    .login-form input:focus { outline: none; border-color: var(--gold); }
    .login-form input::placeholder { color: rgba(255,255,255,.25); }
    .btn-login { width: 100%; background: var(--gold); color: var(--navy-deep); border: none; border-radius: 10px; padding: .9rem; font-weight: 700; font-size: .95rem; cursor: pointer; transition: all .2s; margin-top: .5rem; }
    .btn-login:hover { background: var(--gold-light); transform: translateY(-1px); }
    .back-link { display: block; text-align: center; margin-top: 1.5rem; color: rgba(255,255,255,.4); font-size: .8rem; text-decoration: none; }
    .back-link:hover { color: var(--gold); }
  </style>
</head>
<body>
  <div class="login-wrap">
    <div class="login-logo">
      <svg width="48" height="48" viewBox="0 0 40 40" fill="none">
        <path d="M20 3C20 3 11 8 9 17C7 26 14 30 20 38C26 30 33 26 31 17C29 8 20 3 20 3Z" fill="url(#loginGrad)"/>
        <defs>
          <linearGradient id="loginGrad" x1="9" y1="3" x2="31" y2="38">
            <stop stop-color="#E8B84B"/><stop offset="1" stop-color="#C9962A"/>
          </linearGradient>
        </defs>
      </svg>
      <span>D'Abbah Foundation</span>
    </div>

    <div class="login-card">
      <h2>Admin Portal</h2>
      <p>Sign in to access the foundation management dashboard.</p>

      <% if (error) { %>
      <div class="login-error" role="alert"><%= error %></div>
      <% } %>

      <form class="login-form" method="POST" action="/auth/login" novalidate>
        <input type="hidden" name="redirect" value="<%= redirect %>"/>
        <div class="form-group">
          <label for="email">Email Address</label>
          <input type="email" id="email" name="email" required autocomplete="email" placeholder="admin@dabbahfoundation.org"/>
        </div>
        <div class="form-group">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" required autocomplete="current-password" placeholder="••••••••"/>
        </div>
        <button type="submit" class="btn-login">Sign In →</button>
      </form>

      <a href="/" class="back-link">← Back to Website</a>
    </div>
  </div>
</body>
</html>
