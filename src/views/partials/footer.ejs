<footer class="site-footer" role="contentinfo">
  <div class="footer-wave" aria-hidden="true">
    <svg viewBox="0 0 1440 60" preserveAspectRatio="none"><path d="M0,30 C360,60 1080,0 1440,30 L1440,60 L0,60 Z" fill="var(--footer-bg)"/></svg>
  </div>

  <div class="footer-body">
    <div class="container">
      <div class="footer-grid">
        <!-- Brand Column -->
        <div class="footer-brand">
          <a href="/" class="footer-logo">
            <svg width="36" height="36" viewBox="0 0 40 40" fill="none">
              <path d="M20 3C20 3 11 8 9 17C7 26 14 30 20 38C26 30 33 26 31 17C29 8 20 3 20 3Z" fill="url(#footerGrad)"/>
              <defs>
                <linearGradient id="footerGrad" x1="9" y1="3" x2="31" y2="38">
                  <stop stop-color="#E8B84B"/><stop offset="1" stop-color="#C9962A"/>
                </linearGradient>
              </defs>
            </svg>
            <span>D'Abbah Foundation</span>
          </a>
          <p class="footer-tagline">Building Hope. Restoring Lives.</p>
          <p class="footer-desc">Creating a drug-free Nigeria through transformative education, compassionate support, and community empowerment since our founding.</p>

          <div class="footer-social">
            <a href="https://twitter.com/dabbahfoundation" target="_blank" rel="noopener noreferrer" aria-label="Twitter">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            </a>
            <a href="https://instagram.com/dabbahfoundation" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
            </a>
            <a href="https://facebook.com/dabbahfoundation" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
            </a>
            <a href="https://linkedin.com/company/dabbahfoundation" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2z"/><circle cx="4" cy="4" r="2"/></svg>
            </a>
          </div>

          <!-- Newsletter -->
          <div class="footer-newsletter">
            <p>Get updates & impact stories</p>
            <div class="newsletter-form" id="newsletterForm">
              <input type="email" placeholder="your@email.com" aria-label="Email for newsletter" id="newsletterEmail"/>
              <button type="button" onclick="subscribeNewsletter()" aria-label="Subscribe">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
              </button>
            </div>
          </div>
        </div>

        <!-- Navigation Columns -->
        <div class="footer-col">
          <h4>Foundation</h4>
          <nav aria-label="Foundation links">
            <a href="/#about">About Us</a>
            <a href="/#values">Our Values</a>
            <a href="/#approach">Our Approach</a>
            <a href="/about#team">Leadership</a>
            <a href="/about#history">Our Story</a>
          </nav>
        </div>

        <div class="footer-col">
          <h4>Programs</h4>
          <nav aria-label="Program links">
            <a href="/programs#school">School Sensitization</a>
            <a href="/programs#recovery">Recovery Support</a>
            <a href="/programs#youth">Youth Leadership</a>
            <a href="/programs#parents">Parent Workshops</a>
            <a href="/programs#rehab">Rehab Referrals</a>
          </nav>
        </div>

        <div class="footer-col">
          <h4>Get Involved</h4>
          <nav aria-label="Involvement links">
            <a href="/donate">Make a Donation</a>
            <a href="/volunteer">Volunteer</a>
            <a href="/contact">Partner With Us</a>
            <a href="/blog">Read Our Stories</a>
            <a href="/gallery">Gallery</a>
          </nav>
        </div>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container">
      <div class="footer-bottom-inner">
        <p>© <%= currentYear %> D'Abbah Foundation. All rights reserved. Registered NGO, Federal Republic of Nigeria.</p>
        <div class="footer-legal">
          <a href="/privacy-policy">Privacy Policy</a>
          <a href="/terms">Terms of Service</a>
        </div>
      </div>
    </div>
  </div>
</footer>

<!-- Scripts -->
<script src="/js/main.js" defer></script>
<% if (typeof extraScripts !== 'undefined') { %>
  <%- extraScripts %>
<% } %>
</body>
</html>
